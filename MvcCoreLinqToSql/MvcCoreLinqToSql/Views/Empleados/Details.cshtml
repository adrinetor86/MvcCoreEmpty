@model Empleado

@if (Model != null)
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Apellido</th>
            <th>Oficio</th>
            <th>Salario</th>

        </tr>
        </thead>

        <tbody>
        <tr>
            <td>@Model.Apellido</td>
            <td>@Model.Oficio</td>
            <td>@Model.Salario</td>

        </tr>
        </tbody>
    </table>
}